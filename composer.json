{
  "name": "bugo/moonshine-heroicons-field",
  "description": "Heroicons selection field for MoonShine",
  "keywords": [
    "moonshine",
    "heroicons"
  ],
  "type": "library",
  "homepage": "https://github.com/dragomano/moonshine-heroicons-field",
  "license": "MIT",
  "authors": [
    {
      "name": "Bugo",
      "email": "bugo@dragomano.ru"
    }
  ],
  "require": {
    "php": "^8.4",
    "blade-ui-kit/blade-heroicons": "^2.7"
  },
  "require-dev": {
    "laravel/pint": "^1.32",
    "moonshine/moonshine": "^5.0",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.7|^5.3",
    "pestphp/pest-plugin-laravel": "^4.0|^5.0",
    "rector/rector": "^2.8"
  },
  "autoload": {
    "psr-4": {
      "Bugo\\MoonShine\\Heroicons\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "MoonShine\\": "vendor/moonshine/moonshine/"
    }
  },
  "scripts": {
    "check": "vendor/bin/rector process --dry-run --clear-cache",
    "rector": "vendor/bin/rector process",
    "lint": "vendor/bin/pint --test",
    "format": "vendor/bin/pint",
    "test": "vendor/bin/pest --colors=always",
    "test-coverage": "vendor/bin/pest --colors=always --coverage --min=100",
    "test-coverage-clover": "vendor/bin/pest --colors=always --min=100 --coverage-clover coverage.xml",
    "test-coverage-html": "vendor/bin/pest --colors=always --min=100 --coverage-html coverage"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Bugo\\MoonShine\\Heroicons\\Providers\\IconServiceProvider"
      ]
    }
  },
  "conflict": {
    "moonshine/moonshine": "<5.0"
  },
  "minimum-stability": "dev",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
